{
  "name": "calambrazo-lima-sierra",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/server"
  ],
  "scripts": {
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend/server && npm start",
    "start:stripe": "stripe listen --forward-to localhost:4242/api/webhook",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\" \"npm run start:stripe\"",
    "build": "node vercel-build.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
